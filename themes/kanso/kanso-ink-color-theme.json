{
  "$schema": "vscode://schemas/color-theme",
  "name": "Kanso Ink",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#c5c9c7",
    "focusBorder": "#658594",
    "selection.background": "#393b44",
    "descriptionForeground": "#a4a7a4",
    "errorForeground": "#c34043",
    "icon.foreground": "#c5c9c7",
    "widget.shadow": "#00000080",
    "textLink.foreground": "#8ba4b0",
    "textLink.activeForeground": "#7fb4ca",
    "textBlockQuote.background": "#1f1f26",
    "textBlockQuote.border": "#393b44",
    "textCodeBlock.background": "#1f1f26",
    "textPreformat.foreground": "#8a9a7b",

    "editor.background": "#14171d",
    "editor.foreground": "#c5c9c7",
    "editorLineNumber.foreground": "#5c6066",
    "editorLineNumber.activeForeground": "#f2f1ef",
    "editorCursor.foreground": "#f2f1ef",
    "editor.selectionBackground": "#393b44",
    "editor.selectionHighlightBackground": "#393b4480",
    "editor.inactiveSelectionBackground": "#393b4460",
    "editor.wordHighlightBackground": "#22262d",
    "editor.wordHighlightStrongBackground": "#393b44",
    "editor.findMatchBackground": "#2d4f67",
    "editor.findMatchHighlightBackground": "#2d4f6780",
    "editor.findRangeHighlightBackground": "#1f1f2680",
    "editor.lineHighlightBackground": "#1f1f26",
    "editor.lineHighlightBorder": "#00000000",
    "editor.rangeHighlightBackground": "#1f1f2680",
    "editorWhitespace.foreground": "#4b4e57",
    "editorIndentGuide.background1": "#22262d",
    "editorIndentGuide.activeBackground1": "#393b44",
    "editorRuler.foreground": "#22262d",
    "editorBracketMatch.background": "#22262d",
    "editorBracketMatch.border": "#393b44",
    "editorBracketHighlight.foreground1": "#c4b28a",
    "editorBracketHighlight.foreground2": "#8992a7",
    "editorBracketHighlight.foreground3": "#8ea4a2",
    "editorBracketHighlight.foreground4": "#a292a3",
    "editorBracketHighlight.foreground5": "#8a9a7b",
    "editorBracketHighlight.foreground6": "#b6927b",
    "editorBracketHighlight.unexpectedBracket.foreground": "#c34043",
    "editorCodeLens.foreground": "#75797f",
    "editorLink.activeForeground": "#7fb4ca",
    "editorError.foreground": "#c34043",
    "editorWarning.foreground": "#dca561",
    "editorInfo.foreground": "#658594",
    "editorHint.foreground": "#6a9589",
    "editorInlayHint.foreground": "#75797f",
    "editorInlayHint.background": "#1f1f26",
    "editorGutter.background": "#14171d",
    "editorGutter.addedBackground": "#76946a",
    "editorGutter.modifiedBackground": "#dca561",
    "editorGutter.deletedBackground": "#c34043",
    "editorOverviewRuler.border": "#14171d",
    "editorOverviewRuler.errorForeground": "#c34043",
    "editorOverviewRuler.warningForeground": "#dca561",
    "editorOverviewRuler.infoForeground": "#658594",
    "editorOverviewRuler.addedForeground": "#76946a",
    "editorOverviewRuler.modifiedForeground": "#dca561",
    "editorOverviewRuler.deletedForeground": "#c34043",
    "editorOverviewRuler.findMatchForeground": "#2d4f67",
    "editorWidget.background": "#14171d",
    "editorWidget.foreground": "#a4a7a4",
    "editorWidget.border": "#22262d",
    "editorSuggestWidget.background": "#14171d",
    "editorSuggestWidget.border": "#22262d",
    "editorSuggestWidget.foreground": "#f2f1ef",
    "editorSuggestWidget.highlightForeground": "#8ba4b0",
    "editorSuggestWidget.selectedBackground": "#393b44",
    "editorHoverWidget.background": "#14171d",
    "editorHoverWidget.border": "#22262d",
    "editorGroup.border": "#22262d",
    "editorGroupHeader.tabsBackground": "#14171d",
    "editorGroupHeader.noTabsBackground": "#14171d",
    "editorGroup.dropBackground": "#2d4f6740",
    "peekView.border": "#393b44",
    "peekViewEditor.background": "#1f1f26",
    "peekViewResult.background": "#14171d",
    "peekViewTitle.background": "#1f1f26",
    "peekViewEditor.matchHighlightBackground": "#2d4f67",
    "peekViewResult.matchHighlightBackground": "#2d4f67",
    "peekViewResult.selectionBackground": "#22262d",
    "diffEditor.insertedTextBackground": "#2b332880",
    "diffEditor.removedTextBackground": "#43242b80",
    "diffEditor.insertedLineBackground": "#2b332860",
    "diffEditor.removedLineBackground": "#43242b60",

    "tab.activeBackground": "#14171d",
    "tab.activeForeground": "#f2f1ef",
    "tab.inactiveBackground": "#14171d",
    "tab.inactiveForeground": "#75797f",
    "tab.border": "#14171d",
    "tab.activeBorderTop": "#c4b28a",
    "tab.hoverBackground": "#1f1f26",
    "tab.unfocusedActiveForeground": "#a4a7a4",

    "activityBar.background": "#14171d",
    "activityBar.foreground": "#c5c9c7",
    "activityBar.inactiveForeground": "#5c6066",
    "activityBar.activeBorder": "#c4b28a",
    "activityBar.border": "#22262d",
    "activityBarBadge.background": "#658594",
    "activityBarBadge.foreground": "#f2f1ef",

    "sideBar.background": "#14171d",
    "sideBar.foreground": "#a4a7a4",
    "sideBar.border": "#22262d",
    "sideBarTitle.foreground": "#a4a7a4",
    "sideBarSectionHeader.background": "#14171d",
    "sideBarSectionHeader.foreground": "#a4a7a4",
    "sideBarSectionHeader.border": "#22262d",

    "list.activeSelectionBackground": "#393b44",
    "list.activeSelectionForeground": "#f2f1ef",
    "list.inactiveSelectionBackground": "#22262d",
    "list.inactiveSelectionForeground": "#c5c9c7",
    "list.hoverBackground": "#1f1f26",
    "list.focusOutline": "#658594",
    "list.highlightForeground": "#8ba4b0",
    "list.errorForeground": "#c34043",
    "list.warningForeground": "#dca561",
    "tree.indentGuidesStroke": "#393b44",

    "statusBar.background": "#14171d",
    "statusBar.foreground": "#a4a7a4",
    "statusBar.border": "#22262d",
    "statusBar.debuggingBackground": "#b6927b",
    "statusBar.debuggingForeground": "#14171d",
    "statusBar.noFolderBackground": "#14171d",
    "statusBarItem.hoverBackground": "#22262d",
    "statusBarItem.remoteBackground": "#22262d",
    "statusBarItem.remoteForeground": "#c5c9c7",

    "titleBar.activeBackground": "#14171d",
    "titleBar.activeForeground": "#c5c9c7",
    "titleBar.inactiveBackground": "#14171d",
    "titleBar.inactiveForeground": "#5c6066",
    "titleBar.border": "#22262d",

    "menu.background": "#14171d",
    "menu.foreground": "#f2f1ef",
    "menu.selectionBackground": "#393b44",
    "menu.separatorBackground": "#22262d",
    "menubar.selectionBackground": "#22262d",

    "panel.background": "#14171d",
    "panel.border": "#22262d",
    "panelTitle.activeForeground": "#f2f1ef",
    "panelTitle.inactiveForeground": "#75797f",
    "panelTitle.activeBorder": "#c4b28a",

    "terminal.background": "#14171d",
    "terminal.foreground": "#c5c9c7",
    "terminalCursor.foreground": "#f2f1ef",
    "terminal.selectionBackground": "#393b44",
    "terminal.ansiBlack": "#14171d",
    "terminal.ansiRed": "#c4746e",
    "terminal.ansiGreen": "#8a9a7b",
    "terminal.ansiYellow": "#c4b28a",
    "terminal.ansiBlue": "#8ba4b0",
    "terminal.ansiMagenta": "#a292a3",
    "terminal.ansiCyan": "#c5c9c7",
    "terminal.ansiWhite": "#a4a7a4",
    "terminal.ansiBrightBlack": "#909398",
    "terminal.ansiBrightRed": "#e46876",
    "terminal.ansiBrightGreen": "#87a987",
    "terminal.ansiBrightYellow": "#e6c384",
    "terminal.ansiBrightBlue": "#7fb4ca",
    "terminal.ansiBrightMagenta": "#938aa9",
    "terminal.ansiBrightCyan": "#7aa89f",
    "terminal.ansiBrightWhite": "#c5c9c7",

    "input.background": "#1f1f26",
    "input.foreground": "#c5c9c7",
    "input.border": "#22262d",
    "input.placeholderForeground": "#5c6066",
    "inputOption.activeBorder": "#658594",
    "inputValidation.errorBorder": "#c34043",
    "inputValidation.warningBorder": "#dca561",
    "dropdown.background": "#1f1f26",
    "dropdown.border": "#22262d",
    "dropdown.foreground": "#c5c9c7",
    "checkbox.background": "#1f1f26",
    "checkbox.border": "#393b44",

    "button.background": "#2d4f67",
    "button.foreground": "#f2f1ef",
    "button.hoverBackground": "#3a6380",
    "button.secondaryBackground": "#22262d",
    "button.secondaryForeground": "#c5c9c7",
    "button.secondaryHoverBackground": "#393b44",
    "badge.background": "#658594",
    "badge.foreground": "#f2f1ef",
    "progressBar.background": "#8ba4b0",

    "scrollbar.shadow": "#00000080",
    "scrollbarSlider.background": "#393b4480",
    "scrollbarSlider.hoverBackground": "#393b44",
    "scrollbarSlider.activeBackground": "#5c6066",

    "notifications.background": "#14171d",
    "notifications.foreground": "#c5c9c7",
    "notifications.border": "#22262d",
    "notificationCenterHeader.background": "#1f1f26",
    "quickInput.background": "#14171d",
    "quickInput.foreground": "#c5c9c7",
    "quickInputList.focusBackground": "#393b44",
    "pickerGroup.foreground": "#c4b28a",
    "pickerGroup.border": "#22262d",
    "keybindingLabel.foreground": "#c5c9c7",
    "keybindingLabel.background": "#22262d",
    "keybindingLabel.border": "#393b44",

    "breadcrumb.foreground": "#75797f",
    "breadcrumb.focusForeground": "#c5c9c7",
    "breadcrumb.activeSelectionForeground": "#f2f1ef",
    "breadcrumbPicker.background": "#14171d",

    "gitDecoration.addedResourceForeground": "#87a987",
    "gitDecoration.modifiedResourceForeground": "#c4b28a",
    "gitDecoration.deletedResourceForeground": "#c4746e",
    "gitDecoration.untrackedResourceForeground": "#8a9a7b",
    "gitDecoration.ignoredResourceForeground": "#5c6066",
    "gitDecoration.conflictingResourceForeground": "#b6927b",

    "minimap.background": "#14171d",
    "minimap.selectionHighlight": "#393b44",
    "minimapGutter.addedBackground": "#76946a",
    "minimapGutter.modifiedBackground": "#dca561",
    "minimapGutter.deletedBackground": "#c34043"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#75797f", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "markup.inline.raw"],
      "settings": { "foreground": "#8a9a7b" }
    },
    {
      "name": "String escapes & regex",
      "scope": ["constant.character.escape", "string.regexp", "constant.other.character-class.regexp"],
      "settings": { "foreground": "#c4746e" }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#a292a3" }
    },
    {
      "name": "Booleans & language constants",
      "scope": ["constant.language", "constant.language.boolean"],
      "settings": { "foreground": "#b6927b" }
    },
    {
      "name": "Other constants",
      "scope": ["constant", "constant.other", "variable.other.constant", "variable.other.enummember", "support.constant"],
      "settings": { "foreground": "#b6927b" }
    },
    {
      "name": "Characters",
      "scope": ["constant.character", "string.quoted.single.char"],
      "settings": { "foreground": "#8a9a7b" }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "keyword.control", "storage.modifier", "keyword.other"],
      "settings": { "foreground": "#8992a7", "fontStyle": "italic" }
    },
    {
      "name": "Storage / declaration keywords",
      "scope": ["storage", "storage.type", "keyword.declaration"],
      "settings": { "foreground": "#8992a7", "fontStyle": "italic" }
    },
    {
      "name": "Control flow return / exceptions",
      "scope": ["keyword.control.flow", "keyword.control.return", "keyword.control.trycatch", "keyword.control.exception"],
      "settings": { "foreground": "#8992a7", "fontStyle": "italic" }
    },
    {
      "name": "Imports / preprocessor",
      "scope": ["keyword.control.import", "keyword.control.export", "keyword.control.from", "keyword.control.directive", "meta.preprocessor", "keyword.control.using"],
      "settings": { "foreground": "#909398", "fontStyle": "" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "keyword.operator.assignment", "keyword.operator.arithmetic", "keyword.operator.logical", "keyword.operator.comparison"],
      "settings": { "foreground": "#909398", "fontStyle": "" }
    },
    {
      "name": "Word operators",
      "scope": ["keyword.operator.new", "keyword.operator.expression", "keyword.operator.word", "keyword.operator.instanceof", "keyword.operator.typeof"],
      "settings": { "foreground": "#909398", "fontStyle": "" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"],
      "settings": { "foreground": "#909398" }
    },
    {
      "name": "String interpolation",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": { "foreground": "#c4b28a" }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "variable.function"],
      "settings": { "foreground": "#8ba4b0" }
    },
    {
      "name": "Methods",
      "scope": ["entity.name.function.member", "entity.name.method", "support.function.any-method"],
      "settings": { "foreground": "#8ba4b0" }
    },
    {
      "name": "Builtin functions",
      "scope": ["support.function.builtin", "support.function.console", "entity.name.function.builtin"],
      "settings": { "foreground": "#8ba4b0" }
    },
    {
      "name": "Constructors",
      "scope": ["entity.name.function.constructor", "new.expr entity.name.type"],
      "settings": { "foreground": "#c4b28a" }
    },
    {
      "name": "Types & classes",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "entity.name.interface", "support.type", "support.class", "entity.other.inherited-class", "storage.type.primitive", "storage.type.built-in"],
      "settings": { "foreground": "#8ea4a2", "fontStyle": "" }
    },
    {
      "name": "Namespaces / modules",
      "scope": ["entity.name.namespace", "entity.name.module", "entity.name.package"],
      "settings": { "foreground": "#8ea4a2" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.other.readwrite", "meta.definition.variable"],
      "settings": { "foreground": "#c5c9c7" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": { "foreground": "#909398" }
    },
    {
      "name": "Properties / fields",
      "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "entity.name.variable.field", "meta.object-literal.key"],
      "settings": { "foreground": "#8992a7" }
    },
    {
      "name": "Language variables (this/self)",
      "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.language.super"],
      "settings": { "foreground": "#8992a7", "fontStyle": "italic" }
    },
    {
      "name": "Decorators / annotations / attributes",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "storage.type.annotation", "entity.other.attribute-name.pragma", "meta.attribute"],
      "settings": { "foreground": "#b6927b" }
    },
    {
      "name": "Macros",
      "scope": ["entity.name.function.macro", "entity.name.function.preprocessor", "support.function.macro"],
      "settings": { "foreground": "#909398" }
    },
    {
      "name": "Labels",
      "scope": ["entity.name.label"],
      "settings": { "foreground": "#8992a7" }
    },
    {
      "name": "HTML/XML tags",
      "scope": ["entity.name.tag", "meta.tag.sgml"],
      "settings": { "foreground": "#c4b28a" }
    },
    {
      "name": "Tag delimiters",
      "scope": ["punctuation.definition.tag"],
      "settings": { "foreground": "#909398" }
    },
    {
      "name": "Tag attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#8992a7" }
    },
    {
      "name": "CSS selectors",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.name.tag.css", "entity.other.attribute-name.pseudo-class.css"],
      "settings": { "foreground": "#8ba4b0" }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name", "support.type.property-name.css"],
      "settings": { "foreground": "#8992a7" }
    },
    {
      "name": "CSS values & units",
      "scope": ["support.constant.property-value", "keyword.other.unit", "support.constant.color"],
      "settings": { "foreground": "#a292a3" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json", "support.type.property-name.json.comments"],
      "settings": { "foreground": "#8992a7" }
    },
    {
      "name": "YAML / TOML keys",
      "scope": ["entity.name.tag.yaml", "support.type.property-name.toml", "keyword.key.toml"],
      "settings": { "foreground": "#8992a7" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown", "punctuation.definition.heading.markdown"],
      "settings": { "foreground": "#8ba4b0", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#c5c9c7", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#c5c9c7", "fontStyle": "italic" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#c4b28a" }
    },
    {
      "name": "Markdown quotes",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#909398", "fontStyle": "italic" }
    },
    {
      "name": "Markdown lists",
      "scope": ["punctuation.definition.list.begin.markdown", "beginning.punctuation.definition.list.markdown"],
      "settings": { "foreground": "#c4b28a" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#76946a" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#c34043" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#dca561" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#c34043" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#717c7c", "fontStyle": "strikethrough" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#8ea4a2",
    "type": "#8ea4a2",
    "class": "#8ea4a2",
    "enum": "#8ea4a2",
    "interface": "#8ea4a2",
    "struct": "#8ea4a2",
    "typeParameter": "#8ea4a2",
    "parameter": "#909398",
    "variable": "#c5c9c7",
    "variable.readonly": "#b6927b",
    "variable.defaultLibrary": "#c4b28a",
    "property": "#8992a7",
    "enumMember": "#b6927b",
    "function": "#8ba4b0",
    "method": "#8ba4b0",
    "function.defaultLibrary": "#8ba4b0",
    "macro": "#909398",
    "keyword": { "foreground": "#8992a7", "italic": true },
    "comment": { "foreground": "#75797f", "italic": true },
    "string": "#8a9a7b",
    "number": "#a292a3",
    "regexp": "#c4746e",
    "operator": "#909398",
    "decorator": "#b6927b",
    "selfKeyword": { "foreground": "#8992a7", "italic": true },
    "*.deprecated": { "strikethrough": true }
  }
}
